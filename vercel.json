{
  "version": 2,
  "builds": [
    { "src": "api/index.ts", "use": "@vercel/node", "config": { "maxDuration": 60 } },
    { "src": "app/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/chat", "dest": "/chat.html" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
