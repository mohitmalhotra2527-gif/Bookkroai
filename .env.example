# ─── BookKaro (RAILBOOK) — environment variables ──────────────────────────────
# STEP 1: PLACEHOLDERS ONLY — every value below is intentionally EMPTY.
#
# Rules (enforced by architecture and tests):
#   - credentials are SERVER-SIDE ONLY — never imported into /app frontend code
#   - never log keys or Authorization headers (see api/config.ts redactSecrets)
#   - never commit real credentials — real values live only in the server
#     environment of a future deployment
# ──────────────────────────────────────────────────────────────────────────────

# ── Step 2: Railway provider layer ────────────────────────────────────────────
# Keys stay EMPTY in this template. The app builds and runs without them;
# railway operations then return a clean RAILWAY_DATA_UNAVAILABLE error.

# RailCore — PRIMARY provider (https://ir.railcore.tech/v1, header X-RailCore-Key)
RAILCORE_API_KEY=

# RailKit — FALLBACK provider (official `railkit` npm SDK, header x-api-key)
RAILKIT_API_KEY=

# ── Step 9: AI gateway (server-side only) ─────────────────────────────────────
# PRIMARY AI model (GPT-OSS-20B on the NVIDIA key). Values stay EMPTY here.
GPT_OSS_MODEL=openai/gpt-oss-20b

# ── Step 8: NVIDIA Nemotron (server-side only) ────────────────────────────────
# Nemotron is the AI model for this integration. Keys stay EMPTY here.
NVIDIA_API_KEY=
# Optional backup key — auto-used when the primary fails (401/402/403/429).
NVIDIA_API_KEY_2=
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# RAILWAY_PROVIDER: fixed routing policy (railcore = primary, RailKit fallback)
RAILWAY_PROVIDER=railcore

# ── Step 3: AI provider (aliases; NVIDIA_* above take precedence) ────────────
# AI_PROVIDER: deterministic | nvidia | gemini   (default: deterministic —
# works with NO key and doubles as the failure/timeout fallback)
AI_PROVIDER=
# AI_MODEL: provider model id (e.g. meta/llama-3.1-70b-instruct, gemini-2.0-flash)
AI_MODEL=
# AI_BASE_URL: custom OpenAI-compatible endpoint (RapidAPI-hosted etc.). Empty = provider default.
AI_BASE_URL=
# AI_API_KEY stays EMPTY here — server-side only, never logged, never in the browser.
AI_API_KEY=
